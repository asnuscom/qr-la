{
  "expo": {
    "name": "QR-la",
    "slug": "qr-la",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qrla",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.asnus.qrla",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Karekod taramak ve etkinlik fotoğraflarını çekmek için kameranıza erişim gereklidir.",
        "NSPhotoLibraryUsageDescription": "Etkinlik fotoğraflarınızı yüklemek ve profilinizi özelleştirmek için galeri erişimi gereklidir."
      }
    },
    "android": {
      "package": "com.asnus.qrla",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#C5A059",
          "defaultChannel": "qrla_notifications"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
